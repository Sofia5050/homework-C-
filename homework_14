#include <iostream>
#include <string>
#include <vector>
#include <stack>
#include <queue>
#include <set>
#include <map>
#include <algorithm>

using namespace std;

void show(vector<int> numbers)
{
    for (int number : numbers)
    {
        cout << number << " ";
    }
    cout << endl;
}

void bubbleSort(vector<int>& numbers)
{
    int comparisons = 0;
    int swaps = 0;

    for (int i = 0; i < numbers.size() - 1; i++)
    {
        for (int j = 0; j < numbers.size() - i - 1; j++)
        {
            comparisons++;

            if (numbers[j] > numbers[j + 1])
            {
                swap(numbers[j], numbers[j + 1]);
                swaps++;
            }
        }
    }

    cout << "Sorted: ";
    show(numbers);

    cout << "Comparisons: " << comparisons << endl;
    cout << "Swaps: " << swaps << endl;
}

void selectionSort(vector<int>& numbers)
{
    int comparisons = 0;
    int swaps = 0;

    for (int i = 0; i < numbers.size() - 1; i++)
    {
        int minIndex = i;

        for (int j = i + 1; j < numbers.size(); j++)
        {
            comparisons++;

            if (numbers[j] < numbers[minIndex])
            {
                minIndex = j;
            }
        }

        if (minIndex != i)
        {
            swap(numbers[i], numbers[minIndex]);
            swaps++;
        }
    }

    cout << "Sorted: ";
    show(numbers);

    cout << "Comparisons: " << comparisons << endl;
    cout << "Swaps: " << swaps << endl;
}

void insertionSort(vector<int>& numbers)
{
    int comparisons = 0;
    int shifts = 0;

    for (int i = 1; i < numbers.size(); i++)
    {
        int key = numbers[i];
        int j = i - 1;

        while (j >= 0)
        {
            comparisons++;

            if (numbers[j] > key)
            {
                numbers[j + 1] = numbers[j];
                shifts++;
                j--;
            }
            else
            {
                break;
            }
        }

        numbers[j + 1] = key;
    }

    cout << "Sorted: ";
    show(numbers);

    cout << "Comparisons: " << comparisons << endl;
    cout << "Shifts: " << shifts << endl;
}

int main()
{
    vector<int> numbers = {5, 3, 8, 1, 2};

    int choice;

    while (true)
    {
        cout << "===== Sorting Analyzer =====" << endl;
        cout << "1. Bubble Sort" << endl;
        cout << "2. Selection Sort" << endl;
        cout << "3. Insertion Sort" << endl;
        cout << "0. Exit" << endl;

        cout << "Choose: ";
        cin >> choice;

        if (choice == 0)
        {
            break;
        }

        cout << "Original: ";
        show(numbers);

        if (choice == 1)
        {
            bubbleSort(numbers);
        }
        else if (choice == 2)
        {
            selectionSort(numbers);
        }
        else if (choice == 3)
        {
            insertionSort(numbers);
        }

        cout << endl;
    }

    return 0;
}
