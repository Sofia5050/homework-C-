#include <iostream>
#include <string>
using namespace std; 
#include <iostream>
using namespace std;

class Payment{
protected:
    double amount;

public:
    Payment(double amount){
        this->amount = amount;
    }

    virtual void pay() = 0;
    virtual void printReceipt() = 0;

    void showAmount(){
        cout << "Сумма к оплате: " << amount << " тг" << endl;
    }
};

class CardPayment : public Payment{
public:
    CardPayment(double amount) : Payment(amount){}

    void pay() override{
        cout << "Оплата картой прошла успешно" << endl;
    }

    void printReceipt() override{
        cout << "Чек: оплата картой" << endl;
    }
};

class KaspiQRPayment : public Payment{
public:
    KaspiQRPayment(double amount) : Payment(amount){}

    void pay() override{
        cout << "Оплата через Kaspi QR подтверждена" << endl;
    }

    void printReceipt() override{
        cout << "Чек: оплата через Kaspi QR" << endl;
    }
};

class BonusPayment : public Payment{
public:
    BonusPayment(double amount) : Payment(amount){}

    void pay() override{
        cout << "Оплата бонусами выполнена" << endl;
    }

    void printReceipt() override{
        cout << "Чек: оплата бонусами" << endl;
    }
};

class CashPayment : public Payment{
public:
    CashPayment(double amount) : Payment(amount){}

    void pay() override{
        cout << "Оплата наличными при получении заказа" << endl;
    }

    void printReceipt() override{
        cout << "Чек: оплата наличными" << endl;
    }
};

int main(){

    Payment* payments[4];

    payments[0] = new CardPayment(4500);
    payments[1] = new KaspiQRPayment(5200);
    payments[2] = new BonusPayment(1800);
    payments[3] = new CashPayment(3000);

    for(int i = 0; i < 4; i++){
        payments[i]->showAmount();
        payments[i]->pay();
        payments[i]->printReceipt();
        cout << endl;
    }

    for(int i = 0; i < 4; i++){
        delete payments[i];
    }

    return 0;
}
